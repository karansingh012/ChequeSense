# ==============================================================================
# ChequeSense Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure local values.
# NEVER commit sensitive credentials or passwords to version control.

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chequesense

# SQLAlchemy Database URL (constructed from above, or overridden directly)
# For local Unix domain socket / default auth: postgresql+psycopg2:///chequesense
# For password auth: postgresql+psycopg2://postgres:your_password@localhost:5432/chequesense
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/chequesense

# Optional Test Database URL (falls back to SQLite in-memory if not provided)
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/chequesense_test

# Pipeline Model Checkpoints
DETECTOR_MODEL_PATH=models/field_detector/best_model.pt
RECOGNIZER_MODEL_PATH=models/recognizer/best_model.pt

# Tesseract OCR Binary Location (Default auto-discovered via PATH or /opt/homebrew/bin/tesseract)
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Security & JWT Authentication
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
